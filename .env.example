# ---- OrbitWork local Docker configuration ----
# Copy to .env, then replace every CHANGE_ME value before exposing to the internet.
NODE_ENV=production
APP_ORIGIN=http://localhost:8080
APP_SECRET=CHANGE_ME_APP_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
REGISTRATION_OPEN=true
# Docker Compose overrides this to exactly one trusted Caddy hop.
TRUST_PROXY=false

# Public entry point (Caddy). :80 works locally via http://localhost:8080.
# For Aliyun set SITE_ADDRESS=work.example.com and HTTP_PORT=80, HTTPS_PORT=443,
# APP_ORIGIN=https://work.example.com, COOKIE_SECURE=true.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# First boot only. Replace with strong credentials and set SEED_DEMO=false in prod.
SEED_ADMIN_EMAIL=admin@orbitwork.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_DEMO_EMAIL=demo@orbitwork.local
SEED_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
SEED_DEMO=false

SANDBOX_TIMEOUT_MS=6000
# Docker Compose uses a no-network file queue. SANDBOX_TOKEN is only needed for
# the loopback HTTP worker used during `npm run dev`.

# OpenAI-compatible model gateway
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODELS=deepseek-chat:DeepSeek Chat,deepseek-reasoner:DeepSeek Reasoner
LLM_TIMEOUT_MS=120000

# Connector SSRF: leave false in production
ALLOW_PRIVATE_CONNECTORS=false
# Local model providers (e.g. Ollama at 127.0.0.1) need this only when configured by an admin.
ALLOW_PRIVATE_PROVIDERS=false

# ---- v1.1 controlled web access (agent web_fetch tool) ----
WEB_FETCH_ENABLED=true
WEB_FETCH_TIMEOUT_MS=15000
WEB_FETCH_MAX_BYTES=1048576
WEB_FETCH_MAX_CHARS=20000

# ---- v1.3 model access + context budget ----
LLM_ADAPTER=legacy          # legacy | port
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=250
LLM_CONTEXT_WINDOW=128000
AGENT_MAX_STEPS=6           # 1-12

# ---- v1.1 workspace files (uploads + agent artifacts) ----
FILES_MAX_FILE_BYTES=5242880
FILES_MAX_WORKSPACE_BYTES=209715200
FILES_MAX_COUNT=500
# FILES_DIR defaults to <DATA_DIR>/files; keep it on the same volume as the DB
